# Go market-simulator base URL
MARKET_SIMULATOR_URL=http://localhost:8070

# Redis (simulation events from market-simulator)
REDIS_URL=redis://localhost:6379/0

# Optional: orchestrator DB access (analytics / future persistence)
DATABASE_URL=postgresql+asyncpg://admin:secret@localhost:5432/tradingsim

# LLM providers (Step 13+ / dashboard launch)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Required for dashboard "Create & launch simulation" (Redis event loop)
REDIS_URL=redis://localhost:6379/0

# Local Ollama / Phase 4 Step 15 (optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:270m

# Integration tests opt-in — requires Postgres data + simulator + Redis:
# RUN_PHASE4_INTEGRATION=1 pytest tests/integration/test_phase4_integration.py -v
# OLLAMA_CHAT_INTEGRATION=1  — also exercises one llm_agent.run_turn against Ollama

# Step 16 — Redis reconnect backoff (orchestrator listener)
# REDIS_RECONNECT_BASE_SECONDS=1.0
# REDIS_RECONNECT_MAX_DELAY_SECONDS=60.0
